#!/usr/bin/env python3
"""
Print the directory Heimdall keeps its state in, creating it if needed.

Heimdall has two roots and conflating them is the defect this exists to
prevent.

**Code root** — `principles/`, `bin/`, the rules. Every script already finds it
from its own location, and that stays correct in both modes.

**State root** — `.heimdall/` (the attached target) and `cases/` (the readings).
In a checkout these sit beside the code. Installed as a plugin they cannot: the
plugin root is a managed cache, replaced wholesale on update and shared across
every project, so state written there would be destroyed by an update and
visible to projects it does not belong to.

Resolution, in order:

1. `$HEIMDALL_STATE` if set — always wins, so a checkout can be pointed
   elsewhere and a plugin can be pointed somewhere the operator chose.
2. Installed as a plugin: `$CLAUDE_PLUGIN_DATA`, the per-plugin directory
   that survives updates.
3. Otherwise, a checkout: the code root itself.

Whether this is a plugin is answered two ways, either sufficing. The explicit
one: `$CLAUDE_PLUGIN_ROOT` names this code root. The structural one: this
code root is not the top of a git work tree — a plugin cache has no git
history of its own, and where it sits inside some unrelated repository the
top level is that repository, not this directory. The first version read only
the environment variable, and a host that ran the plugin without setting it
left the cache reading as a checkout, at which point bin/principles-ref ran
git where there was none and exited 128 instead of falling back to the plugin
version pin built for exactly that case. Reported from a session that had
HEIMDALL_STATE set and CLAUDE_PLUGIN_ROOT not.

Usage:
  bin/heimdall-state          print the state root
  bin/heimdall-state --mode   print "checkout" or "plugin"
"""

import os
import subprocess
import sys
from pathlib import Path

HOME = Path(__file__).resolve().parent.parent


def is_plugin_install():
    plugin_root = os.environ.get("CLAUDE_PLUGIN_ROOT")
    if plugin_root and Path(plugin_root).resolve() == HOME:
        return True
    try:
        top = subprocess.run(["git", "-C", str(HOME), "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True)
    except OSError:
        return True                      # no git at all: certainly not a checkout
    if top.returncode != 0:
        return True                      # not inside any work tree
    return Path(top.stdout.strip()).resolve() != HOME


def resolve():
    is_plugin = is_plugin_install()

    override = os.environ.get("HEIMDALL_STATE")
    if override:
        return Path(override).expanduser(), ("plugin" if is_plugin else "checkout")

    if is_plugin:
        data = os.environ.get("CLAUDE_PLUGIN_DATA")
        if not data:
            sys.exit("heimdall: running as a plugin but CLAUDE_PLUGIN_DATA is unset, "
                     "and there is nowhere safe to keep a case.\n"
                     "Set HEIMDALL_STATE to a writable directory and retry.")
        return Path(data).expanduser(), "plugin"

    return HOME, "checkout"


def main():
    state, mode = resolve()
    if "--mode" in sys.argv[1:]:
        print(mode)
        return 0
    try:
        state.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        sys.exit(f"heimdall: cannot create state directory {state}: {e}")
    print(state)
    return 0


if __name__ == "__main__":
    sys.exit(main())
